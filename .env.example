# Copy values into your local environment; never commit real credentials.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=attendance_app
DB_PASSWORD=replace-me
DB_NAME=attendance_database1

# Lower LBPH distance is stricter; calibrate with held-out classroom videos.
LBPH_DISTANCE_THRESHOLD=42
LBPH_MIN_VOTES=5
