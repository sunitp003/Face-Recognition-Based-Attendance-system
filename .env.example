# Copy values into your local environment; never commit real credentials.
SECRET_KEY=replace-with-a-long-random-secret
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=attendance_app
DB_PASSWORD=replace-me
DB_NAME=attendance_database1

# Higher cosine similarity is stricter. Calibrate on held-out classroom videos.
SFACE_COSINE_THRESHOLD=0.45
SFACE_MIN_MARGIN=0.06
SFACE_MIN_VOTES=3
